#compdef tinypm tiny grab grab-add-repo grab-de syspm

local -a commands providers
commands=(
  install search remove update upgrade list info check explain run managed apps
  discover pin unpin pinned bundle sync history doctor selftest export-state
  import-state add-repo de undo help version
)
providers=(
  --native --flatpak --snap --apk --apt --dnf --pacman --xbps --zypper
  --emerge --eopkg --swupd --slackpkg --opkg --urpmi --guix --brew --nix
)

_arguments -C \
  '(-d --dry-run)'{-d,--dry-run}'[preview without changing the system]' \
  '(-n --native)'{-n,--native}'[use the detected native provider]' \
  '(-f --flatpak)'{-f,--flatpak}'[use Flatpak]' \
  '(-s --snap)'{-s,--snap}'[use Snap]' \
  '--help[show help]' '--version[show version]' \
  '1:command or package:($commands $providers)' \
  '*:package or argument:_files'
