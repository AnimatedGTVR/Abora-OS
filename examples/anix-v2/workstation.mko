using ANIX;

# Build an ANIX Plan without reading or changing system state.
main() {
    ANIX.set("hostname", "everest-workstation");
    ANIX.enable("bluetooth");
    ANIX.enable("gaming");
    ANIX.enable("gaming.big-picture");
    ANIX.package("firefox");
    ANIX.package("git");
    ANIX.finish();
}
