/work
/out
/result
*.iso
*.lock
# vendor/tinypm is a real vendored Rust crate, not a build byproduct --
# nix/profiles/live.nix and nix/modules/installed-base.nix's tinypmPackage
# derivations both build it via `cargoLock.lockFile = .../Cargo.lock`, so
# this one *.lock file must be tracked for a fresh clone to build at all.
!/vendor/tinypm/Cargo.lock
!/tools/abora-installer/Cargo.lock
/tools/abora-installer/target/
.codex

# Modularity prebuilt binary (run `make setup-modularity` to populate)
/vendor/modularity/bin/
/vendor/modularity/lib/

# Python cache
__pycache__/
*.pyc

# Generated images
*.img
*.iso
*.qcow2
