<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain console runner instead of xunit: no NuGet restore, and it reports
       in the Labs line format (LABS-TEST: PASS|FAIL <name>). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DowngradeGuard.csproj" />
  </ItemGroup>

</Project>
