module Updater.Guard;

# Spec: experiments/updater/shared/README.md

# The largest value a version part may have: a signed 32-bit int.
func MaxPart()::int {
    return 2147483647;
}

func CharAt(let text::string, let index::int)::string {
    return String.Substring(text, index, 1);
}

func IsDigit(let character::string)::bool {
    return String.Length(character) == 1 && String.Contains("0123456789", character);
}

func StripV(let tag::string)::string {
    if String.StartsWith(tag, "v") {
        return String.Substring(tag, 1, String.Length(tag) - 1);
    }
    return tag;
}

#! Strips one leading "v" and any non-numeric suffix ("v4.1-DEMO2" -> "4.1").
#! A value that doesn't start with a digit is returned unchanged ("edge" -> "edge").
pub func TagBaseVersion(let tag::string)::string {
    let stripped = StripV(tag);
    let length = String.Length(stripped);
    if length == 0 || !IsDigit(CharAt(stripped, 0)) {
        return stripped;
    }
    # Keep [0-9]+(\.[0-9]+)*: a dot only counts when a digit follows it.
    mut accepted = 0;
    for index in 0..length {
        let character = CharAt(stripped, index);
        if IsDigit(character) {
            accepted = index + 1;
        } else {
            if character != "." || index + 1 >= length {
                return String.Substring(stripped, 0, accepted);
            }
            if !IsDigit(CharAt(stripped, index + 1)) {
                return String.Substring(stripped, 0, accepted);
            }
        }
    }
    return String.Substring(stripped, 0, accepted);
}

func IsNumericPart(let part::string)::bool {
    let length = String.Length(part);
    # Longer than any 32-bit int: also keeps String.ToInt far from 64-bit overflow.
    if length == 0 || length > 10 {
        return false;
    }
    for index in 0..length {
        if !IsDigit(CharAt(part, index)) {
            return false;
        }
    }
    return String.ToInt(part) <= MaxPart();
}

#! Non-empty, and every dot-separated part is a decimal 32-bit int.
pub func IsNumeric(let version::string)::bool {
    if version == "" {
        return false;
    }
    for part in String.Split(version, ".") {
        if !IsNumericPart(part) {
            return false;
        }
    }
    return true;
}

func PartAt(let parts::list<string>, let index::int)::int {
    if index < List.Length(parts) {
        return String.ToInt(parts[index]);
    }
    return 0;
}

#! Numeric versions sort before non-numeric refs; returns -1, 0 or 1.
pub func Compare(let a::string, let b::string)::int {
    let aNumeric = IsNumeric(a);
    let bNumeric = IsNumeric(b);
    if aNumeric != bNumeric {
        if aNumeric {
            return -1;
        }
        return 1;
    }
    if !aNumeric {
        return String.Compare(a, b);
    }
    let aParts = String.Split(a, ".");
    let bParts = String.Split(b, ".");
    mut count = List.Length(aParts);
    if List.Length(bParts) > count {
        count = List.Length(bParts);
    }
    for index in 0..count {
        let av = PartAt(aParts, index);
        let bv = PartAt(bParts, index);
        if av < bv {
            return -1;
        }
        if av > bv {
            return 1;
        }
    }
    return 0;
}

pub func VersionLessThan(let a::string, let b::string)::bool {
    return a != b && Compare(a, b) < 0;
}

#! Whether updating from `current` to `selectedRef` may proceed.
pub func Allows(let current::string, let selectedRef::string, let allowDowngrade::bool)::bool {
    if selectedRef == "edge" || allowDowngrade {
        return true;
    }
    return !VersionLessThan(TagBaseVersion(selectedRef), current);
}
